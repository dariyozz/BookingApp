# Neon pooled/runtime URL (or another PostgreSQL connection string).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/DB_NAME?sslmode=require

# Optional unpooled Neon connection URL for Prisma migrations.
# When omitted, migrations use DATABASE_URL.
DIRECT_URL=

# Optional backend-only Gemini configuration.
GEMINI_API_KEY="replace-with-your-key"
GEMINI_MODEL="gemini-3.8-flash"

PORT=3001
CLIENT_URL="http://localhost:5173"
