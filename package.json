{
  "name": "teamlift-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run start:dev",
    "build:client": "npm --workspace client run build",
    "build:server": "npm --workspace server run build",
    "db:generate": "npm --workspace server run prisma:generate",
    "db:migrate": "npm --workspace server run db:migrate",
    "db:seed": "npm --workspace server run db:seed",
    "db:cleanup-demo": "npm --workspace server run db:cleanup-demo",
    "test": "npm --workspace server run test",
    "lint": "npm --workspace client run lint && npm --workspace server run lint"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.57.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  }
}
